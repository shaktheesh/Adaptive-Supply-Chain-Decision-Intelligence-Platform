# Option 1: SQLite (Zero configuration needed, recommended for quick start)
# DATABASE_URL=sqlite:///./supply_chain_ai.db

# Option 2: MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=supply_chain_ai
DB_USER=root
DB_PASSWORD=your_mysql_password

# Security & CORS
SECRET_KEY=your-super-secret-jwt-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

